{
  "name": "ottv2-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "replay-viewer"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:admin": "vite --mode admin --port 5174 --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src shared replay-viewer/src tests/*.ts tests/*.tsx vite.config.ts",
    "format:check": "prettier --check src shared replay-viewer/src tests/*.ts tests/*.tsx vite.config.ts",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && vite build --mode admin",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@ottv2/replay-viewer": "1.0.0",
    "@tanstack/react-query": "5.90.16",
    "@tanstack/react-table": "8.21.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.1.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.7",
    "@types/prismjs": "1.26.5",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
