# Local development only. Do not use this combined file on VPS1 or VPS2.
# Copy to infra/.env and replace the placeholders before starting services.
# For deployment, use vps1.env.example on VPS1 and vps2.env.example on VPS2.

POSTGRES_DB=ottv2
POSTGRES_USER=ottv2
POSTGRES_PASSWORD=dev-replace-this-password
DATABASE_URL=postgresql+psycopg://ottv2:dev-replace-this-password@postgres:5432/ottv2
POSTGRES_PORT=5432

REDIS_PASSWORD=dev-replace-this-password
REDIS_URL=redis://:dev-replace-this-password@redis:6379/0
REDIS_PORT=6379

MINIO_ROOT_USER=dev-root-user
MINIO_ROOT_PASSWORD=dev-replace-this-long-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY_ID=dev-replace-with-separate-app-key
S3_SECRET_ACCESS_KEY=dev-replace-with-separate-app-secret
S3_BUCKET=ottv2
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

JWT_SECRET=dev-replace-with-random-secret
WORKER_API_TOKEN=dev-replace-with-random-worker-token
INTERNAL_API_BASE_URL=http://backend:8000/api/v1
REGISTRY_URL=registry:5000
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://localhost:5173/ws
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
ALLOW_DEVELOPMENT_TOURNAMENTS=false
RULESET_ID=dev-v1
# Scrimmage admission (contracts/behavior.md, contract 1.3.0): unfinished scrimmages a team may have created,
# scrimmage games waiting for a worker before new ones are refused, and tournament games (queued or running)
# that pause new scrimmages (0 disables that pause).
SCRIMMAGE_MAX_ACTIVE_PER_TEAM=2
SCRIMMAGE_MAX_PENDING_GAMES=12
SCRIMMAGE_PAUSE_TOURNAMENT_JOBS=1
