# Development only. Replace placeholder secrets locally; never expose them to VITE_*.
DATABASE_URL=postgresql+psycopg://ottv2:replace-me@postgres:5432/ottv2
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ottv2
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
JWT_SECRET=replace-with-random-secret
WORKER_API_TOKEN=replace-with-random-worker-token
INTERNAL_API_BASE_URL=http://backend:8000/api/v1
REGISTRY_URL=registry:5000
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://localhost:5173/ws
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
ALLOW_DEVELOPMENT_TOURNAMENTS=false
RULESET_ID=dev-v1
# Names/ports are contract targets; Compose implementation is still required.
