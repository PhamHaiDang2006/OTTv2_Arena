# VPS2 only. It deliberately has no DATABASE_URL, POSTGRES_PASSWORD, or JWT_SECRET.
# Copy to VPS2 infra/.env; replace every placeholder and keep it root-readable only.
VPS2_WORKER_IMAGE=ghcr.io/replace-owner/ottv2-worker@sha256:replace-with-real-64-hex-digest
VPS2_REDIS_URL=redis://:replace-with-random-production-password@10.77.0.1:6379/0
VPS2_INTERNAL_API_BASE_URL=http://10.77.0.1:8000/api/v1
VPS2_S3_ENDPOINT_URL=http://10.77.0.1:9000
VPS2_REGISTRY_URL=127.0.0.1:5000
# Digests verified by runner/scripts/dev_e2e.py (dev only, linux/amd64):
#   python@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258 (python:3.12-slim-bookworm)
#   gcc@sha256:1d71f0f3450214bef38fe09e6f610fb6cca90cf97b43f4ce845bfc32a4168818 (gcc:13.3.0-bookworm)
# C++ bots are linked with -static, so the C++ runtime image needs no libstdc++.
RUNNER_IMAGE_PYTHON=ghcr.io/replace-owner/ottv2-python-runtime@sha256:replace-with-real-64-hex-digest
RUNNER_IMAGE_CPP=ghcr.io/replace-owner/ottv2-cpp-runtime@sha256:replace-with-real-64-hex-digest
RUNNER_BUILD_IMAGE_CPP=ghcr.io/replace-owner/ottv2-cpp-builder@sha256:replace-with-real-64-hex-digest
OTTv2_ENGINE_FACTORY=ottv2.adapter:make_engine
OTTv2_BUILD_VERIFIER=ottv2_runner.engine_verifier:make_build_verifier

WORKER_API_TOKEN=replace-with-the-same-worker-callback-token-as-vps1
S3_BUCKET=ottv2
WORKER_S3_ACCESS_KEY_ID=replace-with-worker-scoped-least-privilege-key
WORKER_S3_SECRET_ACCESS_KEY=replace-with-worker-scoped-least-privilege-secret

# Default runner host: >=8 logical CPUs; preflight budget 9.25 GiB, recommend >=12 GiB RAM.
# Bot tournament CPUs must be distinct and outside AUX; AUX shares build/smoke/scrimmage/control.
VPS2_AUX_CPUSET=6-7
VPS2_BUILD_CPUSET=6-7
VPS2_TOURNAMENT_1_BLUE=0
VPS2_TOURNAMENT_1_RED=1
VPS2_TOURNAMENT_2_BLUE=2
VPS2_TOURNAMENT_2_RED=3
VPS2_TOURNAMENT_3_BLUE=4
VPS2_TOURNAMENT_3_RED=5
VPS2_SCRIMMAGE_BLUE=6
VPS2_SCRIMMAGE_RED=7
VPS2_WORKER_CPUS=0.5
VPS2_WORKER_MEMORY=512m
