# VPS1 only. Copy to VPS1 infra/.env and replace every placeholder.
# Generate unique random secrets. Use URL-safe alphanumeric passwords because
# REDIS_PASSWORD is embedded in the worker Redis URL on VPS2.
DOMAIN=arena.example.org
STORAGE_DOMAIN=storage.arena.example.org
VPS1_WG_IP=10.77.0.1

VPS1_BACKEND_IMAGE=ghcr.io/replace-owner/ottv2-backend@sha256:replace-with-real-64-hex-digest
VPS1_P1_IMAGE=ghcr.io/replace-owner/ottv2-p1@sha256:replace-with-real-64-hex-digest
VPS1_P2_IMAGE=ghcr.io/replace-owner/ottv2-p2@sha256:replace-with-real-64-hex-digest
VPS1_MINIO_IMAGE=ghcr.io/replace-owner/minio-community@sha256:replace-with-real-64-hex-digest
VPS1_MC_IMAGE=ghcr.io/replace-owner/minio-client@sha256:replace-with-real-64-hex-digest

POSTGRES_DB=ottv2
POSTGRES_USER=ottv2
POSTGRES_PASSWORD=replace-with-random-production-password
DATABASE_URL=postgresql+psycopg://ottv2:replace-with-random-production-password@postgres:5432/ottv2
REDIS_PASSWORD=replace-with-random-production-password

MINIO_ROOT_USER=replace-with-production-root-user
MINIO_ROOT_PASSWORD=replace-with-long-random-production-root-password
S3_ACCESS_KEY_ID=replace-with-least-privilege-app-and-worker-key
S3_SECRET_ACCESS_KEY=replace-with-least-privilege-app-secret
S3_BUCKET=ottv2
JWT_SECRET=replace-with-long-random-production-jwt-secret
WORKER_API_TOKEN=replace-with-long-random-worker-callback-token
ALLOW_DEVELOPMENT_TOURNAMENTS=false
RULESET_ID=dev-v1
# Scrimmage admission (contracts/behavior.md, contract 1.3.0): unfinished scrimmages a team may have created,
# scrimmage games waiting for a worker before new ones are refused, and tournament games (queued or running)
# that pause new scrimmages (0 disables that pause).
SCRIMMAGE_MAX_ACTIVE_PER_TEAM=2
SCRIMMAGE_MAX_PENDING_GAMES=12
SCRIMMAGE_PAUSE_TOURNAMENT_JOBS=1

# Daily mirror read key for the source bucket, separate from application/worker keys.
MINIO_MIRROR_SOURCE_ACCESS_KEY_ID=replace-with-read-only-source-key
MINIO_MIRROR_SOURCE_SECRET_ACCESS_KEY=replace-with-read-only-source-secret
# Daily one-way mirror destination. Use a separate provider/bucket/account.
MINIO_BACKUP_ENDPOINT_URL=https://s3.example.net
MINIO_BACKUP_BUCKET=ottv2-backups
MINIO_BACKUP_PREFIX=arena/minio
MINIO_BACKUP_ACCESS_KEY_ID=replace-with-backup-only-access-key
MINIO_BACKUP_SECRET_ACCESS_KEY=replace-with-backup-only-secret
