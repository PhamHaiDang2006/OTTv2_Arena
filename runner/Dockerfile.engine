# Build from repository root: docker build -f runner/Dockerfile.engine -t ottv2-worker:local .
FROM python:3.12.10-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY engine /opt/engine
COPY runner /opt/runner
RUN python -m pip install --no-cache-dir /opt/engine /opt/runner
ENV OTTv2_ENGINE_FACTORY=ottv2.adapter:make_engine \
    OTTv2_BUILD_VERIFIER=ottv2_runner.engine_verifier:make_build_verifier
CMD ["ottv2-runner-worker", "--queue", "build"]
